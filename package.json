{
  "name": "closure",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "main": "app/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron": "npx electron .",
    "dist": "vite build && electron-builder",
    "preview": "vite preview"
  },
  "build": {
    "appId": "CLOSURE.PRTS-VIS",
    "productName": "PRTS-Vis",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico"
    },
    "files": [
      "dist/**/*",
      "app/**/*",
      "build/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "WuTong260",
      "repo": "PRTS-Vis"
    }
  },
  "devDependencies": {
    "electron": "^41.5.0",
    "electron-builder": "^26.0.0",
    "mammoth": "^1.12.0",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
